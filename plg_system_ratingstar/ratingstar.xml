<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_RATINGSTAR</name>
    <author>Baumgärtner Marketing GmbH</author>
    <authorUrl>https://bm1.de</authorUrl>
    <creationDate>2026-11</creationDate>
    <copyright>(C) Baumgärtner Marketing GmbH</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.0.0</version>
    <description>PLG_SYSTEM_RATINGSTAR_XML_DESCRIPTION</description>
    <namespace path="src">RatingStar\Plugin\System\Ratingstar</namespace>
    <files>
        <folder plugin="ratingstar">services</folder>
        <folder>language</folder>
        <folder>src</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic" addruleprefix="RatingStar\Plugin\System\Ratingstar\Rule">
                <field
                    name="slug"
                    type="text"
                    label="PLG_SYSTEM_RATINGSTAR_FIELD_SLUG_LABEL"
                    description="PLG_SYSTEM_RATINGSTAR_FIELD_SLUG_DESC"
                    filter="cmd"
                    hint="cafe-sonne"
                />

                <field
                    name="group"
                    type="text"
                    label="PLG_SYSTEM_RATINGSTAR_FIELD_GROUP_LABEL"
                    description="PLG_SYSTEM_RATINGSTAR_FIELD_GROUP_DESC"
                    filter="cmd"
                />

                <field
                    name="api_key"
                    type="text"
                    label="PLG_SYSTEM_RATINGSTAR_FIELD_API_KEY_LABEL"
                    description="PLG_SYSTEM_RATINGSTAR_FIELD_API_KEY_DESC"
                    message="PLG_SYSTEM_RATINGSTAR_FIELD_API_KEY_INVALID"
                    filter="trim"
                    validate="apikey"
                    maxlength="48"
                    autocomplete="off"
                    hint="rs_live_…"
                />

                <field
                    name="jsonld"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="PLG_SYSTEM_RATINGSTAR_FIELD_JSONLD_LABEL"
                    description="PLG_SYSTEM_RATINGSTAR_FIELD_JSONLD_DESC"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="jsonld_note"
                    type="note"
                    label="PLG_SYSTEM_RATINGSTAR_FIELD_JSONLD_NOTE_LABEL"
                    description="PLG_SYSTEM_RATINGSTAR_FIELD_JSONLD_NOTE_DESC"
                />

                <field
                    name="whitelist_note"
                    type="note"
                    label="PLG_SYSTEM_RATINGSTAR_FIELD_WHITELIST_NOTE_LABEL"
                    description="PLG_SYSTEM_RATINGSTAR_FIELD_WHITELIST_NOTE_DESC"
                />

                <field
                    name="privacy_note"
                    type="note"
                    label="PLG_SYSTEM_RATINGSTAR_FIELD_PRIVACY_NOTE_LABEL"
                    description="PLG_SYSTEM_RATINGSTAR_FIELD_PRIVACY_NOTE_DESC"
                />
            </fieldset>

            <fieldset name="advanced">
                <field
                    name="base_origin"
                    type="url"
                    label="PLG_SYSTEM_RATINGSTAR_FIELD_BASE_ORIGIN_LABEL"
                    description="PLG_SYSTEM_RATINGSTAR_FIELD_BASE_ORIGIN_DESC"
                    default="https://ratingstar.de"
                    filter="url"
                    validate="url"
                    schemes="http,https"
                    hint="https://ratingstar.de"
                />

                <field
                    name="cache_lifetime"
                    type="number"
                    label="PLG_SYSTEM_RATINGSTAR_FIELD_CACHE_LABEL"
                    description="PLG_SYSTEM_RATINGSTAR_FIELD_CACHE_DESC"
                    default="360"
                    min="5"
                    max="1440"
                    step="1"
                    filter="integer"
                    validate="number"
                />
            </fieldset>
        </fields>
    </config>
</extension>
